#!/bin/sh /etc/rc.common
#
# wrt.cloudinit – Cloud-Init (NoCloud) for OpenWrt on Proxmox 8 (LXC/KVM)
#
#   • eth0 → WAN  (static | dhcp4) — клиент; на WAN открыты только SSH,
#     LuCI (80/443), ICMP и продление DHCP
#   • ethX → LAN* (static → DHCP-server, dhcp4 → DHCP-client), LAN → WAN с NAT
#
# Сид берётся только из доверенного источника (lib/seed.sh): CD-ROM
# гипервизора или раздел cidata на загрузочном диске. Флешки и вторые диски
# игнорируются. Повторный провижн со съёмного носителя (SD/USB) — только при
# `uci set wrt_cloudinit.main.allow_removable_reprovision=1`.
#

START=47
STOP=10
USE_PROCD=1
PROG="wrt.cloudinit"
CIDATA=/mnt/cidata
CLOUDINIT_READY_FLAG=/run/wrt-cloudinit.ready
FIRSTBOOT_SCRIPT=/usr/libexec/bisquite-firstboot.sh
RESIZE_REBOOT_FLAG=/tmp/.root-resize-reboot
SEED_DEV=
SEED_CLASS=
CI_ADMIN_HASH=
# Путь должен совпадать с тем, куда COPY_IN кладёт lib/ в openwrt.vmfile
# (virt-customize --copy-in вкладывает basename: lib → /usr/lib/wrt-cloudinit/lib).
WRT_LIBDIR=/usr/lib/wrt-cloudinit/lib

# Подъём чистых функций из lib (парсеры, state). FATAL, если их нет.
load_libs() {
	local found
	[ -d "$WRT_LIBDIR" ] || return 1
	found=0
	for f in "$WRT_LIBDIR"/*.sh; do
		[ -f "$f" ] || continue
		# shellcheck disable=SC1090
		. "$f" || return 1
		found=1
	done
	[ "$found" = 1 ]
}

# ---------------------------------------------------------------- cidata
is_mounted() {
	grep -q " $1 " /proc/mounts 2>/dev/null
}

# seed_label <dev> → метка ФС (пусто, если не определить)
seed_label() {
	command -v blkid >/dev/null 2>&1 || return 0
	blkid -s LABEL -o value "$1" 2>/dev/null
}

# seed_candidates → устройства, похожие на сид: все CD-ROM и все разделы с
# меткой cidata. Доверие решает classify_seed_dev, а не этот список.
seed_candidates() {
	local d
	for d in /dev/sr[0-9]*; do
		[ -b "$d" ] && echo "$d"
	done
	if command -v blkid >/dev/null 2>&1; then
		blkid -o device -t LABEL=cidata 2>/dev/null
		blkid -o device -t LABEL=CIDATA 2>/dev/null
	fi
}

# mount_cidata → смонтировать доверенный сид в $CIDATA; заполняет SEED_DEV и
# SEED_CLASS. Гипервизор предпочтительнее загрузочного диска.
mount_cidata() {
	local dev cls want label
	[ -d "$CIDATA" ] || mkdir -p "$CIDATA"
	is_mounted "$CIDATA" && umount "$CIDATA" 2>/dev/null

	for want in hypervisor bootdisk; do
		for dev in $(seed_candidates | sort -u); do
			cls=$(classify_seed_dev "$dev")
			if [ "$cls" = untrusted ]; then
				[ "$want" = hypervisor ] && \
					logger -t "$PROG" "ignoring seed candidate $dev: not hypervisor drive, not boot disk"
				continue
			fi
			[ "$cls" = "$want" ] || continue
			label=$(seed_label "$dev")
			case "$label" in
				cidata|CIDATA) ;;
				*) continue ;;
			esac
			if mount -o ro,nosuid,nodev,noexec "$dev" "$CIDATA" 2>/dev/null; then
				SEED_DEV=$dev
				SEED_CLASS=$cls
				logger -t "$PROG" "seed: $dev ($cls)"
				return 0
			fi
		done
	done
	return 1
}

umount_cidata() {
	is_mounted "$CIDATA" || return 0
	umount "$CIDATA" && rmdir "$CIDATA"
}

mark_cloudinit_ready() {
	touch "$CLOUDINIT_READY_FLAG"
}

run_firstboot_commands() {
	local script="$FIRSTBOOT_SCRIPT"
	[ -s "$script" ] || return 0
	chmod +x "$script" >/dev/null 2>&1 || true
	logger -t "$PROG" "executing firstboot commands from $script"
	if sh "$script"; then
		logger -t "$PROG" "firstboot commands completed"
	else
		logger -t "$PROG" "firstboot commands failed"
	fi
	rm -f "$script"
}

# ------------------------------------------------ user-data (host/pwd) --
apply_user_data() {
	local ud="$CIDATA/user-data"
	[ -f "$ud" ] || return 0

	local host ci_user ci_pass
	host=$(awk -F': *' '$1=="hostname"||$1=="fqdn"{print $2;exit}' "$ud" | tr -d ' "')
	case "$host" in
		*[!A-Za-z0-9.-]*|-*|'')
			[ -n "$host" ] && logger -t "$PROG" "invalid hostname '$host' ignored"
			;;
		*)
			# `system` к S47 уже стартовал: без явного применения имя
			# появилось бы только после перезагрузки.
			uci set system.@system[0].hostname="$host"
			uci commit system
			echo "$host" > /proc/sys/kernel/hostname
			/etc/init.d/system reload >/dev/null 2>&1 || true
			;;
	esac

	# Плоские ключи — диалект Proxmox: их пишет сам гипервизор при
	# `bs compose up`.
	ci_user=$(awk -F': *' '$1=="user"{print $2;exit}' "$ud" | tr -d ' "')
	ci_pass=$(awk -F': *' '$1=="password"{print $2;exit}' "$ud" | tr -d ' "')

	# Пользователей задаёт ОДИН из двух диалектов, и плоский побеждает список
	# `users:` — так было и раньше. Изменилось другое: прежде плоская ветка
	# выходила из функции целиком (`return 0`), унося с собой не только список
	# `users:`, но и `apply_root_password`, и `stage_runcmd` внизу. Сид, где
	# рядом с плоским `user:` стоит `chpasswd:` или `runcmd:`, применялся
	# не полностью — и молчал об этом, а тихо недоприменённый сид тут самый
	# дорогой вид отказа.
	#
	# Цену надо назвать честно: ни один из двух поддерживаемых путей этим
	# не бился. `bs compose up` ставит пароль root на сборке через
	# `virt-customize`, а не сидом, и кладёт firstboot-команды прямо
	# в $FIRSTBOOT_SCRIPT; `bs device write` пишет список `users:`, а не
	# плоский ключ, то есть шёл второй веткой и до низа функции доходил.
	# Это была ловушка для сида, написанного руками или смешанного, а не
	# действующий отказ.
	if [ "$ci_user" = root ]; then
		# Proxmox с ciuser=root: пароль и ключи — самому root.
		if [ -n "$ci_pass" ]; then
			set_root_password "$(prepare_password_hash "$ci_pass")"
		fi
		install_key_lines root "$(parse_toplevel_ssh_keys "$ud")"
	elif [ -n "$ci_user" ]; then
		if [ -n "$ci_pass" ]; then
			create_ci_admin "$ci_user" "$ci_pass" || \
				logger -t "$PROG" "failed to provision user $ci_user"
		else
			logger -t "$PROG" "user '$ci_user' requested but password missing"
		fi
		# Proxmox пишет ключи (`--sshkeys`) на верхний уровень, не в `users:`.
		install_ssh_keys "$ci_user" "$ud"
		install_key_lines "$ci_user" "$(parse_toplevel_ssh_keys "$ud")"
	else
		# Список `users:` — стандартный cloud-config, его пишет `bs device write`.
		# `create_ci_admin` готовый хеш пропускает как есть: `prepare_password_hash`
		# отдаёт без изменений всё, что начинается с `$`.
		#
		# Цикл читает heredoc, а не конвейер: в ash `… | while` идёт в
		# подоболочке, и CI_ADMIN_HASH из create_ci_admin терялся —
		# ensure_root_not_open не видел пароля пользователя, и root без
		# chpasswd оставался с пустым паролем.
		local name hash
		while IFS='|' read -r name hash; do
			[ -n "$name" ] || continue
			if [ -z "$hash" ]; then
				logger -t "$PROG" "user '$name' requested but password missing"
				continue
			fi
			if create_ci_admin "$name" "$hash"; then
				install_ssh_keys "$name" "$ud"
			else
				logger -t "$PROG" "failed to provision user $name"
			fi
		done <<EOF
$(parse_users "$ud")
EOF
		install_key_lines root "$(parse_toplevel_ssh_keys "$ud")"
	fi

	apply_root_password "$ud"
	stage_runcmd "$ud"
}

# --------------------------------------------------- пароль root --------
# Бисквит пишет его через `chpasswd: list: - root:$6$…`, а не в списке
# `users:`. Раньше это не читалось, и устройство приезжало с ПУСТЫМ паролем
# root — то есть в дефолтном состоянии OpenWrt, хотя манифест просил другое.
apply_root_password() {
	local hash
	hash=$(parse_root_password "$1")
	[ -n "$hash" ] || return 0
	set_root_password "$(prepare_password_hash "$hash")"
}

set_root_password() {
	local hash=$1
	[ -n "$hash" ] || return 0
	ensure_system_files
	if ! grep -q '^root:' /etc/shadow 2>/dev/null; then
		printf 'root:!:0:0:99999:7:::\n' >> /etc/shadow
	fi
	update_shadow_entry root "$hash"
	logger -t "$PROG" "root password set from seed"
}

# ------------------------------------------------ firstboot из runcmd ---
# Команды манифеста бисквит кладёт в `runcmd:`. Отдельного механизма для них
# не заводим: выгружаем в тот же скрипт, который наполняет Proxmox-адаптер,
# и его выполняет уже существующий run_firstboot_commands — с логированием и
# удалением после запуска.
stage_runcmd() {
	local cmds
	[ -s "$FIRSTBOOT_SCRIPT" ] && return 0

	cmds=$(parse_runcmd "$1")
	[ -n "$cmds" ] || return 0

	mkdir -p "$(dirname "$FIRSTBOOT_SCRIPT")" 2>/dev/null || return 0
	{
		echo '#!/bin/sh'
		printf '%s\n' "$cmds"
	} > "$FIRSTBOOT_SCRIPT"
	chmod +x "$FIRSTBOOT_SCRIPT" 2>/dev/null || true
	logger -t "$PROG" "staged $(printf '%s\n' "$cmds" | wc -l) runcmd entries"
}

# ------------------------------------------------------- ssh-ключи ------
# Раньше `ssh_authorized_keys` не обрабатывался вовсе: ключи из манифеста
# бисквита доезжали до карты и там оставались. Ключи кладутся и пользователю,
# и root — dropbear на OpenWrt читает authorized_keys обоих.
#
# Что означает второй каталог, и это решение, а не деталь: ключ пользователя,
# положенный в `/etc/dropbear/authorized_keys`, даёт вход ПОД ROOT. Так ведёт
# себя код с самого начала, записи об умысле в репозитории нет, и эта работа
# поведение не меняет — только перестаёт его удваивать. Развести два хранилища
# (ключи пользователя — только в его `~/.ssh`) или оставить как есть — решение
# владельца; до него `/etc/dropbear` читается как «любой пользователь из сида
# получает root по своему ключу».
install_ssh_keys() {
	install_key_lines "$1" "$(parse_ssh_keys "$2" "$1")"
}

# install_key_lines <user> <ключи построчно>
install_key_lines() {
	local user=$1 keys=$2 home dir dirs
	[ -n "$keys" ] || return 0
	# Имя из сида идёт в путь (/home/<имя>/.ssh): без проверки «../x»
	# писало бы ключи мимо домашнего каталога.
	if [ "$user" != root ] && ! validate_username "$user"; then
		logger -t "$PROG" "ssh keys for invalid user '$user' ignored"
		return 0
	fi

	if [ "$user" = root ]; then
		dirs=/etc/dropbear
	else
		home=$(user_field "$user" 6)
		[ -n "$home" ] || home="/home/$user"
		dirs="$home/.ssh /etc/dropbear"
	fi
	for dir in $dirs; do
		[ -d "$dir" ] || mkdir -p "$dir" || continue
		# Не `>>`: при повторном провижне дописывание удваивало строки.
		# Почему не `>` — см. merge_authorized_keys в lib/authkeys.sh:
		# /etc/dropbear/authorized_keys общий на всех пользователей сида.
		merge_authorized_keys "$dir/authorized_keys" "$keys" || \
			logger -t "$PROG" "failed to write $dir/authorized_keys"
		chmod 0700 "$dir" 2>/dev/null || true
		chmod 0600 "$dir/authorized_keys" 2>/dev/null || true
	done
	[ "$user" = root ] || chown -R "$user:$user" "$home/.ssh" 2>/dev/null || true
	logger -t "$PROG" "ssh keys installed for $user"
}

# -------------------------- CI user helpers ----------------------------
uci_cmd() {
	uci "$@" >/dev/null 2>&1 || {
		logger -t "$PROG" "uci $* failed"
		return 1
	}
}

validate_username() {
	case "$1" in
		''|root) return 1 ;;
		[!a-z_]*) return 1 ;;
		*[!a-zA-Z0-9_-]*) return 1 ;;
	esac
	[ "${#1}" -le 32 ]
}

hash_password() {
	local plain=$1 hashed=

	if command -v mkpasswd >/dev/null 2>&1; then
		if hashed=$(mkpasswd -m sha512 "$plain" 2>/dev/null); then
			printf '%s\n' "$hashed"
			return 0
		elif hashed=$(mkpasswd -m sha-512 "$plain" 2>/dev/null); then
			printf '%s\n' "$hashed"
			return 0
		elif hashed=$(mkpasswd "$plain" 2>/dev/null); then
			printf '%s\n' "$hashed"
			return 0
		fi
	fi

	if command -v openssl >/dev/null 2>&1; then
		if hashed=$(openssl passwd -6 "$plain" 2>/dev/null); then
			printf '%s\n' "$hashed"
			return 0
		fi
	fi

	return 1
}

prepare_password_hash() {
	case "$1" in
		\$*) printf '%s\n' "$1"; return 0 ;;
	esac
	hash_password "$1"
}

ensure_system_files() {
	# `local` обязателен: в dash область видимости динамическая, и цикл без
	# него затирает переменную ВЫЗЫВАЮЩЕГО. Именно так `apply_user_data`
	# теряла путь к user-data — после create_ci_admin её `$f` становился
	# `/etc/shadow`, и ssh-ключи искались не в том файле.
	local f
	for f in /etc/passwd /etc/group /etc/shadow; do
		[ -f "$f" ] || touch "$f"
	done
	chmod 0644 /etc/passwd /etc/group >/dev/null 2>&1 || true
	chmod 0600 /etc/shadow >/dev/null 2>&1 || true
}

group_gid_by_name() {
	awk -F: -v name="$1" '$1==name{print $3; exit}' /etc/group
}

user_uid_by_name() {
	awk -F: -v name="$1" '$1==name{print $3; exit}' /etc/passwd
}

user_field() {
	awk -F: -v name="$1" -v idx="$2" '$1==name{print $idx; exit}' /etc/passwd
}

ensure_group() {
	local name=$1 gid
	gid=$(group_gid_by_name "$name")
	if [ -n "$gid" ]; then
		printf '%s\n' "$gid"
		return 0
	fi
	gid=$(next_id_from /etc/group 1000) || return 1
	printf '%s:x:%s:\n' "$name" "$gid" >> /etc/group
	printf '%s\n' "$gid"
}

update_passwd_entry() {
	local name=$1 uid=$2 gid=$3 comment=$4 home=$5 shell=$6
	local tmp need_update=0 cur_home cur_shell cur_comment

	if grep -q "^$name:" /etc/passwd; then
		cur_home=$(user_field "$name" 6)
		cur_shell=$(user_field "$name" 7)
		cur_comment=$(user_field "$name" 5)
		[ "$cur_home" = "$home" ] || need_update=1
		[ "$cur_shell" = "$shell" ] || need_update=1
		[ -n "$cur_comment" ] || need_update=1

		if [ "$need_update" -eq 1 ]; then
			tmp=$(mktemp /tmp/passwd.XXXXXX)
			awk -F: -v OFS=":" -v name="$name" -v home="$home" -v shell="$shell" -v comment="$comment" '
				$1==name {
					if($5=="") $5=comment
					$6=home
					$7=shell
				}
				{print}
			' /etc/passwd > "$tmp"
			cat "$tmp" > /etc/passwd && rm -f "$tmp"
		fi
	else
		printf '%s:x:%s:%s:%s:%s:%s\n' "$name" "$uid" "$gid" "$comment" "$home" "$shell" >> /etc/passwd
	fi
}

update_shadow_entry() {
	local name=$1 hash=$2 tmp now days
	now=$(date +%s 2>/dev/null || echo 0)
	days=$((now / 86400))
	tmp=$(mktemp /tmp/shadow.XXXXXX)
	awk -F: -v OFS=":" -v name="$name" -v hash="$hash" -v lastchg="$days" '
		$1==name { $2=hash; $3=lastchg; found=1 }
		{ print }
		END{
			if(!found){
				printf "%s:%s:%s:0:99999:7:::\n", name, hash, lastchg
			}
		}
	' /etc/shadow > "$tmp"
	cat "$tmp" > /etc/shadow && rm -f "$tmp"
	chmod 0600 /etc/shadow >/dev/null 2>&1 || true
}

ensure_home() {
	local home=$1 owner=$2 group=$3
	mkdir -p "$home"
	chown "$owner:$group" "$home"
	chmod 750 "$home"
}

rpcd_acl_has_value() {
	# shellcheck disable=SC2318
	local section=$1 field=$2 value=$3 key="rpcd.$section.$field"
	uci -q show "$key" 2>/dev/null | grep -F "$key='$value'" >/dev/null 2>&1
}

ensure_rpcd_acl_value() {
	local section=$1 field=$2 value=$3 key
	key="rpcd.$section.$field"
	rpcd_acl_has_value "$section" "$field" "$value" || uci_cmd add_list "$key=$value"
}

rpcd_acl_present() {
	local section=$1 field
	for field in read write; do
		rpcd_acl_has_value "$section" "$field" '*' || return 1
	done
	return 0
}

configure_rpcd_login() {
	local user=$1 section pass_ref
	pass_ref="\$p\$${user}"
	# Имя секции — само имя пользователя. Здесь стояло
	# `section="${RPCD_SECTION_PREFIX}${user}"`, но эта переменная не
	# присваивалась нигде: ни в этом файле, ни в `lib/`, ни в окружении, —
	# то есть секция всегда была просто `rpcd.<имя>`. Замысла в истории тоже
	# нет: `git log -S RPCD_SECTION_PREFIX --all` даёт один коммит, `28b1561
	# refactor: group extensions by OS`, которым файл и приехал в репозиторий.
	#
	# Префикс задавать НЕЛЬЗЯ, и это не стилистика. Префикс — это
	# ПЕРЕИМЕНОВАНИЕ секции UCI: устройство, провижненное прежним кодом,
	# несёт `rpcd.<имя>`, повторный провижн создал бы `rpcd.<префикс><имя>`,
	# а прежняя секция осталась бы на месте — два входа в LuCI на одного
	# пользователя. Вводить префикс можно только вместе с удалением прежней
	# секции, то есть отдельным осознанным решением о миграции, а не
	# вдогонку опечатке.
	section="$user"

	uci -q delete rpcd."$section" || true
	uci_cmd set rpcd."$section"=login || return 1
	uci_cmd set rpcd."$section".username="$user" || return 1
	uci_cmd set rpcd."$section".password="$pass_ref" || return 1
	uci -q delete rpcd."$section".read || true
	uci -q delete rpcd."$section".write || true
	ensure_rpcd_acl_value "$section" read '*'
	ensure_rpcd_acl_value "$section" write '*'
	uci_cmd commit rpcd || return 1

	rpcd_acl_present "$section" || return 1

	if [ -x /etc/init.d/rpcd ]; then
		/etc/init.d/rpcd reload >/dev/null 2>&1 || /etc/init.d/rpcd restart >/dev/null 2>&1 || true
	fi
}

ensure_root_rpcd_login() {
	configure_rpcd_login root || \
		logger -t "$PROG" "failed to provision root rpcd login"
}

create_ci_admin() {
	local username=$1 password=$2 home shell comment uid gid hash

	if ! validate_username "$username"; then
		logger -t "$PROG" "invalid ci username '$username'"
		return 1
	fi

	ensure_system_files
	hash=$(prepare_password_hash "$password") || {
		logger -t "$PROG" "failed to hash password for $username"
		return 1
	}

	gid=$(ensure_group "$username") || {
		logger -t "$PROG" "failed to ensure group for $username"
		return 1
	}

	if id "$username" >/dev/null 2>&1; then
		uid=$(user_uid_by_name "$username")
	else
		uid=$(next_id_from /etc/passwd 1000) || return 1
	fi

	home="/home/$username"
	shell="/bin/ash"
	comment="OpenWrt admin ($username)"

	update_passwd_entry "$username" "$uid" "$gid" "$comment" "$home" "$shell"
	update_shadow_entry "$username" "$hash"
	[ -n "$CI_ADMIN_HASH" ] || CI_ADMIN_HASH=$hash
	ensure_home "$home" "$username" "$username"
	configure_rpcd_login "$username" || logger -t "$PROG" "rpcd ACL setup failed for $username"

	logger -t "$PROG" "ci user $username provisioned"
}

# ------------------------- uhttpd helper --------------------------------
ensure_uhttpd_ready() {
	# Сертификат uhttpd генерирует сам при старте (px5g). Прежний вызов
	# несуществующего /usr/lib/uhttpd/keygen.sh всегда «проваливался», и HTTPS
	# выключался насовсем — LuCI оставалась только на HTTP.
	if [ -s /etc/uhttpd.crt ] || command -v px5g >/dev/null 2>&1; then
		uci set uhttpd.main.redirect_https='1'
	else
		uci set uhttpd.main.redirect_https='0'
		uci -q delete uhttpd.main.listen_https
	fi
}

# ------------------------------------------------- net-config -----------
# write_network_uci → записать сеть, dhcp и firewall сида в uci (с commit),
# ничего не перезапуская. Удаляются и пишутся заново только свои секции
# (lib/owned.sh): интерфейсы и зоны других программ — awg0, wg*, podkop —
# переживают провижн нового instance-id. Код 1 — сид невалиден, uci не тронут.
write_network_uci() {
	local nf="$CIDATA/network-config" dm
	# Валидация тоже по обеим версиям: v2 приезжает от `bs device write`.
	if ! parse_netcfg_any "$nf" | grep -q '^[^|][^|]*|'; then
		logger -t "$PROG" "network-config невалиден (нет WAN) — пропуск, текущая сеть сохранена"
		return 1
	fi

	# ---------- DNS ---------------------------------------------------
	IFS='|' read -r DNS SEARCH <<EOF
$(read_dns_any "$nf")
EOF
	DNS=$(echo "$DNS" | tr -d ' ')
	# DNS — только через UCI (network.wan.dns, dhcp.domain): /etc/resolv.conf
	# в OpenWrt — ссылка в tmpfs, её переписывает dnsmasq.

	# ---------- свои секции network/dhcp — заново ---------------------
	purge_owned network
	purge_owned dhcp

	# dnsmasq не пересоздаётся: в нём настройки других программ (podkop).
	dm=$(dnsmasq_section)
	if [ -z "$dm" ]; then
		dm=wrt_dnsmasq
		uci set dhcp."$dm"=dnsmasq
	fi
	uci set dhcp."$dm".domainneeded='1'
	uci set dhcp."$dm".authoritative='1'
	uci set dhcp."$dm".localservice='1'
	uci set dhcp."$dm".rebind_protection='1'
	[ -n "$SEARCH" ] && uci set dhcp."$dm".domain="$SEARCH"

	uci set network.loopback=interface
	uci set network.loopback.device='lo'
	uci set network.loopback.proto='static'
	uci set network.loopback.ipaddr='127.0.0.1'
	uci set network.loopback.netmask='255.0.0.0'

	local LAN_DEVS="" idx=0
	while IFS='|' read -r IFACE PROTO IP NM GW; do
		[ -z "$IFACE" ] && continue
		if [ "$idx" -eq 0 ]; then
			# ------- WAN (eth0) ---------------------------------------
			uci set network.wan=interface
			uci set network.wan.device="$IFACE"
			uci set network.wan.proto="$PROTO"
			if [ "$PROTO" = "static" ]; then
				uci set network.wan.ipaddr="$IP"
				uci set network.wan.netmask="$NM"
				uci set network.wan.gateway="$GW"
			fi
			[ -n "$DNS" ] && {
				uci set network.wan.peerdns='0'
				uci add_list network.wan.dns="$DNS"
			}
		else
			# ------- LANs --------------------------------------------
			if [ "$idx" -eq 1 ]; then
				NAME="lan"
				BRDEV="br-lan"
			else
				NAME="lan$((idx-1))"
				BRDEV="br-lan$((idx-1))"
			fi

			# LAN всегда через мост: чтобы к нему можно было
			# добавлять Wi-Fi AP (phy*-ap*) и доп. порты.
			# Имя uci-секции — без дефисов (br_lan), netdev — br-lan.
			BRSEC=$(echo "$BRDEV" | tr -- '-' '_')
			uci set network."$BRSEC"=device
			uci set network."$BRSEC".name="$BRDEV"
			uci set network."$BRSEC".type='bridge'
			uci add_list network."$BRSEC".ports="$IFACE"

			uci set network."$NAME"=interface
			uci set network."$NAME".device="$BRDEV"

			if [ "$PROTO" = "static" ]; then
				# ---- static + DHCP-server ----------------------------
				uci set network."$NAME".proto='static'
				uci set network."$NAME".ipaddr="$IP"
				uci set network."$NAME".netmask="$NM"

				uci set dhcp."$NAME"=dhcp
				uci set dhcp."$NAME".interface="$NAME"
				uci set dhcp."$NAME".start='10'
				uci set dhcp."$NAME".limit='150'
				uci set dhcp."$NAME".leasetime='12h'
			else
				# ---- DHCP-client -------------------------------------
				uci set network."$NAME".proto='dhcp'
			fi
			LAN_DEVS="$LAN_DEVS $BRDEV"
		fi
		idx=$((idx+1))
	done <<EOF
$(parse_netcfg_any "$nf")
EOF

	uci commit network
	uci commit dhcp

	# ---------- firewall: свои секции — заново ------------------------
	purge_owned firewall

	# Прежде WAN был открыт целиком (input ACCEPT): наружу смотрели DNS
	# dnsmasq, rpcd и всё, что слушает порт. Теперь — REJECT и явные
	# разрешения: SSH и LuCI (доступ к машине по WAN — исходный замысел),
	# ICMP и продление DHCP. Все секции именованные (wrt_*): по имени их
	# и находит purge_owned при следующем провижне.
	uci set firewall.wrt_defaults=defaults
	uci set firewall.wrt_defaults.input='REJECT'
	uci set firewall.wrt_defaults.output='ACCEPT'
	uci set firewall.wrt_defaults.forward='REJECT'
	uci set firewall.wrt_defaults.synflood_protect='1'

	# ---- LAN zone ----------------------------------------------------
	uci set firewall.wrt_lan=zone
	uci set firewall.wrt_lan.name='lan'
	uci set firewall.wrt_lan.input='ACCEPT'
	uci set firewall.wrt_lan.output='ACCEPT'
	uci set firewall.wrt_lan.forward='ACCEPT'
	for d in $LAN_DEVS; do
		uci add_list firewall.wrt_lan.device="$d"
	done

	# ---- WAN zone ----------------------------------------------------
	uci set firewall.wrt_wan=zone
	uci set firewall.wrt_wan.name='wan'
	uci set firewall.wrt_wan.input='REJECT'
	uci set firewall.wrt_wan.output='ACCEPT'
	uci set firewall.wrt_wan.forward='REJECT'
	uci add_list firewall.wrt_wan.network='wan'
	uci set firewall.wrt_wan.masq='1'
	uci set firewall.wrt_wan.mtu_fix='1'

	# Без forwarding LAN-клиенты не выходили в WAN вовсе.
	uci set firewall.wrt_lan_wan=forwarding
	uci set firewall.wrt_lan_wan.src='lan'
	uci set firewall.wrt_lan_wan.dest='wan'

	fw_allow_wan() { # section name proto port [family]
		uci set firewall."$1"=rule
		uci set firewall."$1".name="$2"
		uci set firewall."$1".src='wan'
		uci set firewall."$1".proto="$3"
		[ -n "${4:-}" ] && uci set firewall."$1".dest_port="$4"
		[ -n "${5:-}" ] && uci set firewall."$1".family="$5"
		uci set firewall."$1".target='ACCEPT'
	}
	fw_allow_wan wrt_dhcp_renew Allow-DHCP-Renew udp 68 ipv4
	fw_allow_wan wrt_ping Allow-Ping icmp '' ipv4
	fw_allow_wan wrt_ssh_wan Allow-SSH-from-WAN tcp 22
	# LuCI с WAN — именованное правило: пока пароль root пуст, оно выключено
	# (lib/luci.sh), иначе rpcd пускал бы с WAN под root без пароля.
	uci set firewall.wrt_luci_wan=rule
	uci set firewall.wrt_luci_wan.name='Allow-LuCI-from-WAN'
	uci set firewall.wrt_luci_wan.src='wan'
	uci set firewall.wrt_luci_wan.proto='tcp'
	uci set firewall.wrt_luci_wan.dest_port='80 443'
	uci set firewall.wrt_luci_wan.target='ACCEPT'
	luci_wan_sync && \
		logger -t "$PROG" "root has no password: LuCI closed on WAN until it is set"

	uci commit firewall
	return 0
}

apply_network_config() {
	local nf="$CIDATA/network-config"
	[ -f "$nf" ] || return 0
	logger -t "$PROG" "applying network-config"
	write_network_uci || return 1

	# ---------- uhttpd -----------------------------------------------
	uci -q delete uhttpd.main.listen_http
	uci -q delete uhttpd.main.listen_https
	uci add_list uhttpd.main.listen_http='0.0.0.0:80'
	uci add_list uhttpd.main.listen_http='[::]:80'
	uci add_list uhttpd.main.listen_https='0.0.0.0:443'
	uci add_list uhttpd.main.listen_https='[::]:443'
	uci set uhttpd.main.rfc1918_filter='0'
	ensure_uhttpd_ready
	uci commit uhttpd
	[ -x /etc/init.d/uhttpd ] && /etc/init.d/uhttpd enable

	# ---------- apply -------------------------------------------------
	killall -q udhcpc 2>/dev/null || true
	/etc/init.d/network  restart
	/etc/init.d/dnsmasq enable
	/etc/init.d/dnsmasq restart
	/etc/init.d/firewall restart
	[ -x /etc/init.d/uhttpd ] && /etc/init.d/uhttpd restart
	return 0
}

# ------------------------------------------- root без пароля ----------
# Чистый OpenWrt — root без пароля, а dropbear и LuCI пускают по пустому
# паролю. Сид Proxmox с ciuser≠root пароль root не задаёт, и с открытым WAN
# машина оставалась доступна всем как root без пароля (проверено на 25.12).
# Если сид дал пароль пользователю — root получает тот же хеш (на OpenWrt нет
# sudo, админ — это root); если паролей нет вовсе — вход root по паролю по SSH
# выключается, остаются ключи и локальная консоль.
ensure_root_not_open() {
	local cur
	cur=$(awk -F: '$1=="root"{print $2; exit}' /etc/shadow 2>/dev/null)
	[ -z "$cur" ] || return 0
	if [ -n "$CI_ADMIN_HASH" ]; then
		set_root_password "$CI_ADMIN_HASH"
		logger -t "$PROG" "root had empty password: set to the seed user's password"
		return 0
	fi
	# LuCI с WAN закрывает правило wrt_luci_wan (luci_wan_sync в apply_network_config).
	uci -q set dropbear.main.RootPasswordAuth='off'
	uci -q commit dropbear
	/etc/init.d/dropbear restart >/dev/null 2>&1 || true
	logger -t "$PROG" "root has no password and seed gives none: SSH password login for root disabled"
}

# --------------------------------------------------------------- main --
start_service() {
	local SEED_ID prev_id
	if [ -e "$RESIZE_REBOOT_FLAG" ]; then
		logger -t "$PROG" "root resize reboot pending — skip this boot"
		return 0
	fi
	load_libs || {
		logger -t "$PROG" "FATAL: нет lib в $WRT_LIBDIR — abort (сеть не трогаем)"
		mark_cloudinit_ready
		return 1
	}
	# Каждую загрузку: пароль root мог появиться после провижна (задан из
	# LAN) — тогда LuCI с WAN открывается; пропал — закрывается.
	if luci_wan_sync; then
		logger -t "$PROG" "LuCI on WAN: rule enabled=$(uci -q get firewall.wrt_luci_wan.enabled) by root password state"
		/etc/init.d/firewall reload >/dev/null 2>&1 || true
	fi

	if ! mount_cidata; then
		logger -t "$PROG" "trusted cidata not found — skip"
		# Скрипт, положенный в образ при деплое (bisquite + virt-customize),
		# от сида не зависит и выполняется и без него.
		run_firstboot_commands
		mark_cloudinit_ready
		return 0
	fi

	SEED_ID=$(get_seed_instance_id "$CIDATA/meta-data")
	: "${SEED_ID:=nocloud}"
	logger -t "$PROG" "instance-id: $SEED_ID"

	if already_provisioned "$SEED_ID"; then
		logger -t "$PROG" "instance '$SEED_ID' already provisioned — per-boot only"
		run_firstboot_commands
		mark_cloudinit_ready
		umount_cidata
		return 0
	fi

	prev_id=$(provisioned_instance_id)
	if [ -n "$prev_id" ] && seed_dev_removable "$SEED_DEV" && \
	   [ "$(uci -q get wrt_cloudinit.main.allow_removable_reprovision)" != 1 ]; then
		logger -t "$PROG" "seed on removable $SEED_DEV has new instance '$SEED_ID' (was '$prev_id'): reprovision refused, set wrt_cloudinit.main.allow_removable_reprovision=1 to allow"
		run_firstboot_commands
		mark_cloudinit_ready
		umount_cidata
		return 0
	fi

	logger -t "$PROG" "provisioning instance '$SEED_ID' from $SEED_DEV ($SEED_CLASS)"
	apply_user_data
	ensure_root_not_open
	ensure_root_rpcd_login
	if apply_network_config; then
		run_firstboot_commands
		mark_provisioned "$SEED_ID" && \
			logger -t "$PROG" "instance '$SEED_ID' provisioned"
	else
		logger -t "$PROG" "network provisioning failed — retry next boot"
	fi

	mark_cloudinit_ready
	umount_cidata
}

stop_service() { :; }
